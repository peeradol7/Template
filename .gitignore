# ClickOnce directory:
publish/

# Publish Web Output
*.[Pp]ublish.xml
*.azurePubxml
# *.pubxml - Subversion users should uncomment this

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# Uncomment if using NuGet repositories to store project specific packages (not recommended)
# !packages/

# Microsoft Azure Build Output
csx/
*.cscfg
*.csdef

# DOTNET_SETTINGS_ID
.settings/

# Visual Studio Code
.vscode/

# Rider
.idea/

# User-specific files
*.sqlproj.user
*.config.user

# Mac
.DS_Store
